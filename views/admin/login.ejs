<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow"><title><%= pageTitle %> | Graduation Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/admin.css">
</head>
<body class="auth-body">
  <main class="auth-card">
    <a class="admin-brand centered" href="/"><span>G</span><strong>Graduation Admin</strong></a>
    <h1>Chào mừng trở lại</h1><p>Đăng nhập để quản lý khách mời và lời chúc.</p>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form class="stack-form" action="/admin/login" method="post">
      <input type="hidden" name="next" value="<%= next %>">
      <label>Tên đăng nhập<input name="username" autocomplete="username" maxlength="50" required autofocus></label>
      <label>Mật khẩu<input type="password" name="password" autocomplete="current-password" required></label>
      <button class="primary-button" type="submit">Đăng nhập</button>
    </form>
  </main>
</body>
</html>
