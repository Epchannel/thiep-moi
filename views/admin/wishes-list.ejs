<%- include('../partials/admin-header', { pageTitle, activePage, admin, csrfToken }) %>
<div class="toolbar"><form class="filter-form" method="get"><input name="search" value="<%= filters.search %>" placeholder="Tìm người gửi hoặc nội dung..."><select name="status"><option value="">Mọi trạng thái</option><option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Đã duyệt</option><option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Chờ duyệt</option><option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Từ chối</option></select><button class="secondary-button" type="submit">Lọc</button></form></div>
<% if (notice) { %><div class="alert success"><%= notice %></div><% } %>
<section class="wish-admin-grid">
  <% if (!wishes.length) { %><div class="panel empty-state"><h2>Không có lời chúc phù hợp</h2></div><% } %>
  <% wishes.forEach((wish) => { %><article class="panel wish-admin-card"><div class="wish-top"><div><strong><%= wish.guestName %></strong><small><%= formatDate(wish.createdAt) %></small></div><span class="badge <%= wish.status %>"><%= wishStatusLabel[wish.status] %></span></div><p>“<%= wish.message %>”</p><div class="card-actions"><% if (wish.guestSlug) { %><a href="/<%= wish.guestSlug %>" target="_blank">Mở thiệp ↗</a><% } %><form method="post" action="/admin/wishes/<%= wish.id %>/status"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><select name="status"><option value="approved" <%= wish.status === 'approved' ? 'selected' : '' %>>Duyệt</option><option value="pending" <%= wish.status === 'pending' ? 'selected' : '' %>>Chờ duyệt</option><option value="rejected" <%= wish.status === 'rejected' ? 'selected' : '' %>>Từ chối</option></select><button class="secondary-button compact" type="submit">Cập nhật</button></form><form method="post" action="/admin/wishes/<%= wish.id %>/delete" data-confirm="Xóa vĩnh viễn lời chúc này?"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><button class="danger-button compact" type="submit">Xóa</button></form></div></article><% }) %>
</section>
<%- include('../partials/admin-footer') %>
